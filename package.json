{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "prepare": "husky || true",
        "lint": "eslint resources/js --fix",
        "lint:check": "eslint resources/js",
        "prettier": "prettier --write \"resources/**/*.{js,vue,css}\" \"**/*.{json,md,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
        "prettier:check": "prettier --check \"resources/**/*.{js,vue,css}\" \"**/*.{json,md,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
        "format": "npm run prettier && npm run lint",
        "check": "npm run lint:check && npm run prettier:check"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@tailwindcss/vite": "^4.3.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "concurrently": "^10.0.7",
        "eslint": "^10.14.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "eslint-plugin-vue": "^10.12.1",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^3.2.1",
        "lint-staged": "^17.6.0",
        "prettier": "^3.10.0",
        "prettier-plugin-organize-attributes": "^1.0.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.5",
        "vite": "^8.3.8",
        "vue-eslint-parser": "^10.4.2"
    },
    "dependencies": {
        "@heroicons/vue": "^2.2.0",
        "@inertiajs/vite": "^3.11.0",
        "@inertiajs/vue3": "^3.11.0",
        "@sentry/vite-plugin": "^11.12.0",
        "@sentry/vue": "^11.12.0",
        "@vue/server-renderer": "^3.5.45",
        "vue": "^3.5.45"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.5",
        "@rollup/rollup-linux-x64-gnu": "4.68.2",
        "@rollup/rollup-win32-x64-msvc": "4.68.2",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.5",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.3.5",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    },
    "lint-staged": {
        "resources/js/**/*.{js,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "**/*.{css,scss,html,json,md,yml,yaml}": [
            "prettier --write"
        ],
        "**/*.php": [
            "php ./vendor/bin/pint --config=pint.json"
        ]
    }
}
